<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/header"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_buo_create_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_buo_create_link" />

    <Button
        android:id="@+id/btn_builder_create_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_builder_create_link" />

    <Button
        android:id="@+id/btn_throws"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_throws" />

    <Button
        android:id="@+id/btn_long_url_fallback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_long_url_fallback" />

    <Button
        android:id="@+id/btn_log_event"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_log_event" />

    <Button
        android:id="@+id/btn_request_deep_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_request_deep_link" />

    <Button
        android:id="@+id/btn_cancel_deep_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_cancel_deep_link" />

    <Button
        android:id="@+id/btn_clear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_clear" />

    <ScrollView
        android:id="@+id/log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

</LinearLayout>
